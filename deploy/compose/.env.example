# Copy to .env (never commit .env). On servers the deploy job writes this file (mode 600).
API_DOMAIN=api.example.com
API_TAG=local
# API_IMAGE=ghcr.io/scottlinddk/template-api
# MIGRATOR_IMAGE=ghcr.io/scottlinddk/template-migrator

POSTGRES_DB=template
POSTGRES_USER=template_owner
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# Runtime user: read/write data only. Migration user: owns the schema.
API_CONNECTION_STRING=Host=postgres;Database=template;Username=app_runtime;Password=change-me-app
MIGRATIONS_CONNECTION_STRING=Host=postgres;Database=template;Username=template_owner;Password=change-me-owner

OPENAPI_ENABLED=false
CORS_ORIGIN=https://app.example.com

# Clerk: Frontend API URL (token issuer) and the frontend origin allowed to call the API (azp).
# Dev instance: https://<slug>.clerk.accounts.dev   Production: https://clerk.<your-domain>
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTY=https://app.example.com
