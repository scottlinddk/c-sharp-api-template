{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "OpenApi": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Clerk": {
    "Issuer": "",
    "AuthorizedParties": [],
    "RejectPendingSessions": true
  }
}
